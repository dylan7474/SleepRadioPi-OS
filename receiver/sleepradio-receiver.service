[Unit]
Description=Sleep Radio receiver (an RTL-SDR dongle as a radio station)
After=network-online.target
Wants=network-online.target

[Service]
# This dongle's own settings (--ppm N --gain DB) are in OPTIONS in this file; see install.sh.
EnvironmentFile=-/etc/sleepradio-receiver/options
ExecStart=/usr/bin/python3 -u /opt/sleepradio-receiver/sleepradio_receiver.py --airband /usr/local/bin/rtl_airband $OPTIONS
# Its own throwaway user, with the group the rtl-sdr package gives the dongle to.
DynamicUser=yes
SupplementaryGroups=plugdev
Restart=always
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
