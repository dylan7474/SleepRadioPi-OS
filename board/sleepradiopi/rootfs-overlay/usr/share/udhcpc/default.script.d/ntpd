#!/bin/sh
# Wi-Fi just got an address. If NTP hasn't set the clock yet (the Pi booted
# offline), restart ntpd so it looks the time servers up now, instead of
# after its own back-off (minutes). This also gets the RTC (if fitted) set
# from the internet soon after Wi-Fi appears.
case "$1" in
	bound|renew)
		[ -e /run/ntp-synced ] || /etc/init.d/S45ntpd restart >/dev/null 2>&1
		;;
esac
exit 0
