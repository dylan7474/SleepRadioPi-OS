#!/bin/sh
# Run the SleepRadioPi station as user radio. Started (and restarted if it
# exits) by init: see the respawn line in /etc/inittab. Output goes to
# syslog: `grep sleepradiopi /var/log/messages`.
#
# Settings: /data/radio/.config/sleepradiopi/config.json
# Stop it for a while:  touch /data/radio/station.off  (then kill it, or reboot)

HOME=/data/radio

# /data may be missing if it couldn't be mounted; don't spin.
if ! grep -q ' /data ' /proc/mounts || [ -e $HOME/station.off ]; then
	sleep 60
	exit 0
fi

mkdir -p $HOME
chown -R radio:radio $HOME
cd $HOME

# Where the station asks for a shutdown (the web page's button); watched by
# power-request-watch, which runs as root.
mkdir -p /run/sleepradiopi
chown radio:radio /run/sleepradiopi
rm -f /run/sleepradiopi/poweroff

# The start-up chime (then the DJ: "Sleep Radio is warming up..."), played
# while the station loads, so a slow start doesn't look like a broken radio.
# It holds /run/sleepradiopi/startup-sound.lock; the station waits for it
# before opening the sound card.
python3 -m sleepradiopi.startup_sound --home $HOME 2>&1 | logger -t startup-sound &

# The clock is only right once NTP has set it (no RTC; often offline).
HOME=$HOME MALLOC_ARENA_MAX=2 SLEEPRADIOPI_CLOCK_FLAG=/run/time-synced \
	SLEEPRADIOPI_POWER_REQUEST=/run/sleepradiopi/poweroff SLEEPRADIOPI_SUPERVISED=1 \
	SLEEPRADIOPI_VOICE_REQUEST=/run/sleepradiopi/voice-install \
	start-stop-daemon -S -c radio \
	-x /usr/bin/python3 -- -u -m sleepradiopi.main 2>&1 |
	logger -t sleepradiopi

# Don't restart in a tight loop if it keeps failing.
sleep 5
