#!/bin/sh
# Run the SleepRadioPi station as user radio. Started (and restarted if it
# exits) by init: see the respawn line in /etc/inittab. Output goes to
# syslog: `grep sleepradiopi /var/log/messages`.
#
# Settings: /data/radio/.config/sleepradiopi/config.json
# Stop it for a while:  touch /data/radio/station.off  (then kill it, or reboot)

HOME=/data/radio

# /data may be missing if it couldn't be mounted; don't spin.
if ! grep -q ' /data ' /proc/mounts || [ -e $HOME/station.off ]; then
	sleep 60
	exit 0
fi

mkdir -p $HOME
chown -R radio:radio $HOME
# Remote access keeps its token + switch here; the web page (user radio) writes
# them, and /data itself is root's, so the folder has to exist and be radio's.
mkdir -p -m 0700 /data/cloudflared
chown radio:radio /data/cloudflared
cd $HOME

# Where the station asks for a shutdown (the web page's button); watched by
# power-request-watch, which runs as root.
mkdir -p /run/sleepradiopi
chown radio:radio /run/sleepradiopi
rm -f /run/sleepradiopi/poweroff

# The cathedral's VU needle and grille light: the two hardware PWM channels
# (config.txt), exported for the station's user. No PWM chip: skipped.
modprobe -q pwm-bcm2835 2>/dev/null
PWM=/sys/class/pwm/pwmchip0
if [ -d $PWM ]; then
	for ch in 0 1; do
		[ -d $PWM/pwm$ch ] || echo $ch > $PWM/export 2>/dev/null
		i=0
		while [ ! -e $PWM/pwm$ch/duty_cycle ] && [ $i -lt 10 ]; do sleep 0.1; i=$((i + 1)); done
		chown radio:radio $PWM/pwm$ch/period $PWM/pwm$ch/duty_cycle $PWM/pwm$ch/enable 2>/dev/null
	done
fi

# The amp's MUTE pin (setting amp_mute_gpio; MiniAmp: GPIO16, low = muted),
# so the station can silence the amp while nothing plays (audio/ampmute.py).
# Exported high (the amp plays: the start-up chime needs it) and linked at
# /run/sleepradiopi/amp-mute for the station's user. A pin something else
# already owns (a button on it) can't be exported: skipped, the amp left alone.
AMPPIN=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("amp_mute_gpio") or 0))' \
	$HOME/.config/sleepradiopi/config.json 2>/dev/null)
rm -f /run/sleepradiopi/amp-mute
if [ "${AMPPIN:-0}" -gt 0 ] 2>/dev/null; then
	for chip in /sys/class/gpio/gpiochip*; do
		[ "$(cat $chip/ngpio 2>/dev/null)" = 54 ] && BASE=$(cat $chip/base) && break
	done
	if [ -n "$BASE" ]; then
		N=$((BASE + AMPPIN))
		[ -d /sys/class/gpio/gpio$N ] || echo $N > /sys/class/gpio/export 2>/dev/null
		if [ -d /sys/class/gpio/gpio$N ] && echo high > /sys/class/gpio/gpio$N/direction 2>/dev/null; then
			chown radio:radio /sys/class/gpio/gpio$N/value 2>/dev/null
			ln -s /sys/class/gpio/gpio$N/value /run/sleepradiopi/amp-mute
		fi
	fi
fi

# The start-up chime (then the DJ: "Sleep Radio is warming up..."), played
# while the station loads, so a slow start doesn't look like a broken radio.
# It holds /run/sleepradiopi/startup-sound.lock; the station waits for it
# before opening the sound card.
python3 -m sleepradiopi.startup_sound --home $HOME 2>&1 | logger -t startup-sound &

# The clock is only right once NTP has set it (no RTC; often offline).
# Nice -5: the music (the speaker feed, aplay and the ffmpeg decoder, which
# inherit it) comes first; the voice worker and the library scan lower
# themselves to +5, so making a line never starves the speaker (drop-outs).
# The station may lock itself in RAM (main._lock_in_memory), so the voice
# reloading its model never pushes the station's code out and stalls the music.
ulimit -l unlimited
HOME=$HOME MALLOC_ARENA_MAX=2 SLEEPRADIOPI_CLOCK_FLAG=/run/time-synced \
	SLEEPRADIOPI_POWER_REQUEST=/run/sleepradiopi/poweroff SLEEPRADIOPI_SUPERVISED=1 \
	SLEEPRADIOPI_VOICE_REQUEST=/run/sleepradiopi/voice-install SLEEPRADIOPI_REMOTE_DIR=/data/cloudflared \
	start-stop-daemon -S -N -5 -c radio \
	-x /usr/bin/python3 -- -u -m sleepradiopi.main 2>&1 |
	logger -t sleepradiopi

# Don't restart in a tight loop if it keeps failing.
sleep 5
