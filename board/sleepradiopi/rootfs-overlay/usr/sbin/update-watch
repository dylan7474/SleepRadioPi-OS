#!/bin/sh
# Install an update when the station asks: the web page's Install makes the
# station (user radio) write $REQ; this (root) downloads the release into the
# spare root slot, checks it, switches cmdline.txt and reboots -- see
# sleepradiopi/updater.py. Progress goes to /run/sleepradiopi/update-status.
# Started by init: see the respawn line in /etc/inittab.

REQ=/run/sleepradiopi/update-request

while sleep 1; do
	[ -e $REQ ] || continue
	logger -t update "installing an update"
	python3 -m sleepradiopi.updater install 2>&1 | logger -t update
done
