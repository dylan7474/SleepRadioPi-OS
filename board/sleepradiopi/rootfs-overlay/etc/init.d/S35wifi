#!/bin/sh
#
# Wi-Fi: the networks in /boot/wpa_supplicant.conf (edit it on a PC) and any
# added on the web page; if none is in range, the radio's own network. Runs
# in the background so boot never waits for the network.
#

CONF=/boot/wpa_supplicant.conf
IFACE=wlan0

start() {
	printf "Starting Wi-Fi: "
	# Offline test: `touch /data/wifi-off-once; reboot` boots with no Wi-Fi
	# and turns it on 5 minutes later (so you can ssh back in).
	if [ -e /data/wifi-off-once ]; then
		rm -f /data/wifi-off-once
		echo "off for 5 minutes (offline test)"
		( sleep 300; "$0" start ) </dev/null >/dev/null 2>&1 &
		return 0
	fi
	# The brcmfmac driver is loaded by udev; give it a moment to appear.
	i=0
	while [ ! -e /sys/class/net/$IFACE ] && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if [ ! -e /sys/class/net/$IFACE ]; then
		echo "FAIL (no $IFACE)"
		return 1
	fi
	# The Wi-Fi manager: the card's and the web page's saved networks, and the
	# radio's own network (hotspot) when none is in range. See
	# sleepradiopi/wifi.py. If it isn't running 20 s later, join the card's
	# network the old way, so a fault in it can't leave the radio unreachable.
	(python3 -m sleepradiopi.wifi manager 2>&1 | logger -t wifi) </dev/null >/dev/null 2>&1 &
	(sleep 20; manager_running || { logger -t wifi "the Wi-Fi manager isn't running: joining the card's network directly"; direct; }) \
		</dev/null >/dev/null 2>&1 &
	echo "OK"
}

manager_running() { ps -o args | grep -q "[s]leepradiopi.wifi manager"; }

# The old way: just the card's network(s).
direct() {
	[ -r "$CONF" ] || return 0
	ip link set $IFACE up
	# Power saving makes the Zero's Wi-Fi laggy and drops the stream.
	iw dev $IFACE set power_save off 2>/dev/null
	wpa_supplicant -B -D nl80211 -i $IFACE -c "$CONF" \
		-P /run/wpa_supplicant.pid -f /var/log/wpa_supplicant.log
	udhcpc -b -S -i $IFACE -x hostname:"$(hostname)" \
		-p /run/udhcpc.$IFACE.pid >/dev/null 2>&1
}

stop() {
	printf "Stopping Wi-Fi: "
	kill $(ps -o pid,args | awk '/[s]leepradiopi.wifi manager/ {print $1}') 2>/dev/null
	killall -q udhcpc wpa_supplicant hostapd dnsmasq
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
