#!/bin/sh
#
# Mount the writable data partition and the read-only media partition.
#
#   /data   p5, ext4 -- settings, caches, the random seed. The only thing
#           written at run time; the app replaces files atomically, and the
#           ext4 journal covers the metadata if the power is pulled.
#   /media  p6, ext4 -- music, voices, jingles. Read-only; written only on
#           a PC (scripts/provision-media.sh) or after `media-rw`.
#
# A card without p6 (flashed from a release, never on a PC since) is given
# one at its first start: the radio makes it, restarts once, formats it,
# and music is then put on from the web page (sleepradiopi/mediapart.py: it
# only ever touches a card laid out exactly as the image leaves it, and
# only formats the partition it made itself). A card that has a p6 never
# gets as far as asking.
#

DATA=/dev/mmcblk0p5
MEDIA=/dev/mmcblk0p6
NOTE=/data/media-partition.json

start() {
	# -p repairs what's safe to repair unattended; after a power cut this
	# is normally just a journal replay. Exit codes 0-1 mean OK or fixed.
	e2fsck -p $DATA >/dev/null 2>&1
	[ $? -le 1 ] || echo "S00data: e2fsck $DATA needs attention" >&2
	if mount -t ext4 -o noatime,errors=remount-ro $DATA /data; then
		# /var/lib/seedrng links here; seedrng won't create it through
		# the link, so the seed would never be saved.
		mkdir -p -m 0700 /data/seedrng
		# Start from the last saved time rather than 1970 (no RTC).
		clock-restore
	else
		echo "S00data: could not mount $DATA" >&2
	fi

	# No music partition, or one part made: the next step of making it.
	if { [ ! -b $MEDIA ] && [ ! -e $NOTE ]; } || grep -qs '"state": "ma' $NOTE; then
		python3 -m sleepradiopi.mediapart 2>&1 | logger -t media-partition
		if grep -qs '"state": "made"' $NOTE && [ ! -b $MEDIA ]; then
			echo "S00data: the music partition is made: restarting to find it" >&2
			sync
			umount /data 2>/dev/null
			reboot
			exit 0
		fi
	fi

	if [ -b $MEDIA ]; then
		mount -t ext4 -o ro,noatime $MEDIA /media ||
			echo "S00data: could not mount $MEDIA" >&2
	fi
}

stop() {
	clock-save
	sync
	umount /data 2>/dev/null
}

case "$1" in
	start) start ;;
	stop)  stop ;;
	*) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
