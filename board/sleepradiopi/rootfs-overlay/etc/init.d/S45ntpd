#!/bin/sh
#
# BusyBox ntpd. The Zero has no real-time clock, so the time is wrong until
# this syncs; ntpd keeps retrying until Wi-Fi is up.
#

start() {
	printf "Starting ntpd: "
	start-stop-daemon -S -q -x /usr/sbin/ntpd -- \
		-p 0.pool.ntp.org -p 1.pool.ntp.org -p 2.pool.ntp.org
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping ntpd: "
	start-stop-daemon -K -q -x /usr/sbin/ntpd
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
